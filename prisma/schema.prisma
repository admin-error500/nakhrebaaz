
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("CUSTOMER")
  orders       Order[]
  savedAddresses SavedAddress[]
  createdAt    DateTime @default(now())
}

model Product {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  category    String
  festival    String?
  image       String
  price       Int
  saleDiscountPercent Int? @default(0)
  active      Boolean   @default(true)
  variants    Variant[]
  createdAt   DateTime  @default(now())
}

model Variant {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  productId  String      @db.ObjectId
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  color      String
  stock      Int         @default(0)
  sku        String      @unique
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model Order {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id])
  status        String    @default("PENDING")
  paymentMethod String
  paymentStatus String    @default("PENDING")

  checkoutId    String?
  invoiceNumber String?
  invoicedAt    DateTime?

  paymentOrderId String?
  paymentId      String?

  subtotal    Int
  shipping    Int
  total       Int
  addressJson String

  items     OrderItem[]
  createdAt DateTime @default(now())

  @@index([checkoutId])
  @@index([paymentOrderId])
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String  @db.ObjectId
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Int
  name      String
  size      String
  color     String
}

model SaleCampaign {
  id         String    @id @map("_id")
  enabled    Boolean   @default(false)
  title      String    @default("NAKHREBAAZ SALE")
  subtitle   String    @default("Limited-time offers on selected styles")
  imageUrl   String?
  buttonText String    @default("SHOP SALE")
  buttonUrl  String    @default("/#shop")
  startsAt   DateTime?
  endsAt     DateTime?
  updatedAt  DateTime  @updatedAt
}

model SavedAddress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag           String   @default("HOME")
  recipientName String
  phone         String
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  pincode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model StorefrontMerchandising {
  id          String   @id @map("_id")
  homepageIds String[] @default([])
  topIds      String[] @default([])
  newIds      String[] @default([])
  detailIds   String[] @default([])
  shuffleDetail Boolean @default(false)
  shuffleHome Boolean  @default(false)
  shuffleTop  Boolean  @default(false)
  shuffleNew  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
